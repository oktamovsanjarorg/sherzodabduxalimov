# --- Database (docker-compose: postgres 5434, redis 6381) ---
DATABASE_URL=postgresql://onatili:onatili@localhost:5434/onatili
REDIS_URL=redis://localhost:6381

# --- Telegram ---
BOT_TOKEN=            # BotFather'dan
MINIAPP_URL=https://example.com   # Mini App HTTPS manzili (dev: cloudflared tunnel)

# --- API ---
API_PORT=4100
JWT_SECRET=change-me-to-long-random-string
JWT_TTL=1h
INIT_DATA_MAX_AGE_SEC=86400
CORS_ORIGINS=http://localhost:5180

# --- AI (3-bosqich) ---
AI_PROVIDER=deepseek  # deepseek | claude | none
OPENAI_API_KEY=            # esse: qo'lyozmani o'qish, tahlil, xato topish (gpt-6-luna). Bo'sh bo'lsa hammasini DeepSeek bajaradi
DEEPSEEK_API_KEY=
DEEPSEEK_ESSAY_MODEL=deepseek-flash   # esse: qayta tekshiruv va taqriz
DEEPSEEK_ESSAY_EFFORT=high             # off | low | high | max
GEMINI_API_KEY=            # OPENAI_API_KEY bo'lmagandagina: qo'lyozma esseni o'qish
ANTHROPIC_API_KEY=

# --- Admin ---
OWNER_USERNAMES=sanjaroktamov,sherzod_abduxalimov
ADMIN_URL=https://example.com/admin
MEDIA_DIR=./.media             # video fayllar (prod: /data/media)

# Seed: to'lov kartasi (faqat birinchi seed'da yoziladi, keyin admin paneldan o'zgartiriladi). Repo ochiq: haqiqiy raqam faqat .env da
SEED_BILLING_CARD=
SEED_BILLING_HOLDER=
