# --- Database (docker-compose: postgres 5434, redis 6381) ---
DATABASE_URL=postgresql://onatili:onatili@localhost:5434/onatili
REDIS_URL=redis://localhost:6381

# --- Telegram ---
BOT_TOKEN=            # BotFather'dan
MINIAPP_URL=https://example.com   # Mini App HTTPS manzili (dev: cloudflared tunnel)

# --- API ---
API_PORT=4100
JWT_SECRET=change-me-to-long-random-string
JWT_TTL=1h
INIT_DATA_MAX_AGE_SEC=86400
CORS_ORIGINS=http://localhost:5180

# --- AI (3-bosqich) ---
AI_PROVIDER=deepseek  # deepseek | claude | none
DEEPSEEK_API_KEY=
GEMINI_API_KEY=            # qo'lyozma esseni o'qish (aistudio.google.com, bepul). Bo'sh bo'lsa AI faqat yozilgan matnni tekshiradi
ANTHROPIC_API_KEY=

# --- Admin ---
OWNER_USERNAMES=sanjaroktamov,sherzod_abduxalimov
