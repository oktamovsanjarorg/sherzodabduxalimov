    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.7",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.9.2",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
