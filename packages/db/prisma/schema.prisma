generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== Foydalanuvchilar =====================

enum Role {
  STUDENT
  PARENT
  ASSISTANT
  TEACHER
}

enum StudyMode {
  ONLINE
  OFFLINE
}

model User {
  id            String   @id @default(cuid())
  /// Ustoz qo'lda kiritgan o'quvchida null: botga kirganda (telefon yoki shaxsiy havola orqali) bog'lanadi
  telegramId    BigInt?  @unique
  username      String?
  firstName     String
  lastName      String?
  phone         String?
  photoUrl      String?
  languageCode  String?
  role          Role     @default(STUDENT)
  /// Ism-familiyani ustoz yozgan: Telegram'dan kirganda ustiga yozilmaydi
  nameLocked    Boolean  @default(false)
  isBlocked     Boolean  @default(false)
  /// Bloklash sababi (foydalanuvchiga ko'rsatiladi)
  blockedReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student               StudentProfile?
  parentLinks           ParentLink[]      @relation("ParentOf")
  parentLinksReviewed   ParentLink[]      @relation("ParentLinkReviewer")
  attempts              Attempt[]
  essays                Essay[]
  essayReviews          EssayReview[]     @relation("Reviewer")
  subscriptions         Subscription[]
  payments              Payment[]
  paymentsReviewed      Payment[]         @relation("PaymentReviewer")
  attendanceMarked      Attendance[]      @relation("AttendanceMarker")
  offlinePaymentsMarked OfflinePayment[]  @relation("OfflinePaymentMarker")
  voiceNotes            VoiceNote[]       @relation("VoiceAuthor")
  lessonProgress        LessonProgress[]
  auditLogs             AuditLog[]
  loginTokens           LoginToken[]
  videos                Video[]
  invitesSent           StaffInvite[]
  followUpsWritten      PaymentFollowUp[] @relation("FollowUpAuthor")
}

model StudentProfile {
  id              String            @id @default(cuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode            StudyMode         @default(ONLINE)
  groupId         String?
  group           Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  parentLinkCode  String            @unique // ota-ona botga shu kod bilan ulanadi
  /// Qo'lda kiritilgan o'quvchining shaxsiy havolasi (t.me/bot?start=s_<kod>): bosganda Telegram hisobi shu yozuvga bog'lanadi
  inviteCode      String?           @unique
  /// Ilovaga kirish: AUTO — obuna yoki offline guruh bo'yicha; FREE — ustoz bepul ochib bergan; CLOSED — ustoz yopib qo'ygan
  accessMode      StudentAccess     @default(AUTO)
  followUps       PaymentFollowUp[]
  /// Ustoz ko'rib chiqqan (guruhga qo'shgan yoki "o'quvchim" deb tasdiqlagan). Botdan o'zi kirgan yangi o'quvchida null
  acceptedAt      DateTime?
  parents         ParentLink[]
  attendance      Attendance[]
  offlinePayments OfflinePayment[]
  createdAt       DateTime          @default(now())
}

enum StudentAccess {
  AUTO
  FREE
  CLOSED
}

enum ParentLinkStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Ota-ona botda havolani ochdi, kontakt ulashishini kutyapmiz. Bazada: bot qayta ishga tushsa ham yo'qolmaydi
model PendingParent {
  telegramId BigInt   @id
  code       String
  createdAt  DateTime @default(now())
}

/// O'quvchi va ota-ona bog'lanishi. Ota-ona bot orqali o'z raqamini ulashadi, ustoz/yordamchi tasdiqlaydi.
model ParentLink {
  id           String           @id @default(cuid())
  parentId     String
  parent       User             @relation("ParentOf", fields: [parentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       ParentLinkStatus @default(PENDING)
  phone        String? // Telegram tasdiqlagan raqam (request_contact)
  relation     String? // ota, ona, boshqa
  flags        String[] // shubhali belgilar: same_phone, student_activity, many_children
  reviewedById String?
  reviewedBy   User?            @relation("ParentLinkReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  rejectReason String?
  createdAt    DateTime         @default(now())

  @@unique([parentId, studentId])
  @@index([status])
}

model Group {
  id              String           @id @default(cuid())
  name            String
  schedule        String? // masalan: "Du/Chor/Ju 14:00"
  /// Offline guruhning oylik to'lovi (so'm). To'lovni belgilashda standart summa
  monthlyFeeUzs   Int?
  /// Guruh havolasi (t.me/bot?start=g_<kod>): o'quvchi bosib, o'zi qo'shiladi. null = havola o'chiq
  inviteCode      String?          @unique
  isActive        Boolean          @default(true)
  students        StudentProfile[]
  attendance      Attendance[]
  offlinePayments OfflinePayment[]
  createdAt       DateTime         @default(now())
}

// ===================== Kontent =====================

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  topics      Topic[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Topic {
  id        String     @id @default(cuid())
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int        @default(0)
  lessons   Lesson[]
  questions Question[]
  tests     Test[]
}

model Lesson {
  id          String           @id @default(cuid())
  topicId     String
  topic       Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title       String
  videoUrl    String? // tashqi havola (YouTube va h.k.)
  videoId     String?          @unique // serverga yuklangan himoyalangan video
  video       Video?           @relation(fields: [videoId], references: [id], onDelete: SetNull)
  content     String? // konspekt (markdown)
  attachments Json             @default("[]") // [{name,url}]
  durationSec Int?
  order       Int              @default(0)
  isFree      Boolean          @default(false)
  isPublished Boolean          @default(false)
  progress    LessonProgress[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model LessonProgress {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@id([userId, lessonId])
}

// ===================== Savollar va testlar =====================

enum QuestionType {
  SINGLE
  MULTIPLE
  MATCHING
  TEXT
  ESSAY // ustoz baholaydi
}

/// Bir nechta savol tayanadigan umumiy matn (o'qish matni, she'r, g'azal, drama parchasi)
model Passage {
  id        String     @id @default(cuid())
  title     String?
  body      String // markdown
  questions Question[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Question {
  id          String          @id @default(cuid())
  topicId     String?
  topic       Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  type        QuestionType    @default(SINGLE)
  passageId   String?
  passage     Passage?        @relation(fields: [passageId], references: [id], onDelete: SetNull)
  text        String
  imageUrl    String?
  explanation String?
  difficulty  Int             @default(2) // 1..5
  correctText String? // TEXT turi uchun
  aiReview    Json? // AI tekshiruv natijasi
  options     Option[]
  tests       TestQuestion[]
  answers     AttemptAnswer[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  matchKey   String? // MATCHING uchun juftlik
  order      Int      @default(0)
}

enum TestType {
  TOPIC
  MOCK
}

enum GradingScale {
  NONE
  MILLIY_SERTIFIKAT // 100 ballik, A+ ... C darajalar
}

model Test {
  id           String         @id @default(cuid())
  type         TestType
  title        String
  description  String?
  topicId      String?
  topic        Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  timeLimitSec Int?
  shuffle      Boolean        @default(true)
  gradingScale GradingScale   @default(NONE)
  /// Rasch kalibrlash: qobiliyatlar (θ) o'rtachasi va standart tafovuti, nechta natijadan hisoblangan
  raschMu      Float?
  raschSigma   Float?
  raschN       Int            @default(0)
  raschAt      DateTime?
  isFree       Boolean        @default(false)
  isPublished  Boolean        @default(false)
  questions    TestQuestion[]
  attempts     Attempt[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model TestQuestion {
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  points     Float    @default(1)
  /// Rasch: savol qiyinligi (logit). Milliy sertifikat testlarida ballni shu beradi
  raschB     Float?

  @@id([testId, questionId])
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model Attempt {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId     String
  test       Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  status     AttemptStatus   @default(IN_PROGRESS)
  startedAt  DateTime        @default(now())
  deadlineAt DateTime? // server vaqti bo'yicha
  finishedAt DateTime?
  score      Float?
  maxScore   Float?
  answers    AttemptAnswer[]

  @@index([userId, testId])
}

model AttemptAnswer {
  attemptId     String
  attempt       Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionIds     String[]
  textAnswer    String?
  isCorrect     Boolean?
  points        Float? // ESSAY uchun ustoz baholaguncha null
  answeredAt    DateTime  @default(now())
  reviewComment String?
  /// Esse: rasmiy mezon bo'yicha 12 band bahosi [{key,label,max,score}] va maxsus holat
  rubric        Json?
  special       String?
  /// Esse matnidagi ustoz belgilagan xatolar [{start,end,type,note}]
  annotations   Json?
  reviewedById  String?
  reviewedAt    DateTime?

  @@id([attemptId, questionId])
}

// ===================== Esse =====================

enum EssayStatus {
  DRAFT // rasmlar yuklanmoqda
  AWAITING_PAYMENT // ustoz tekshiruvi: to'lov kutilmoqda
  SUBMITTED // ustoz navbatida
  AI_CHECKING
  AI_CHECKED
  AI_FAILED
  REVIEWED // ustoz baholadi
}

enum EssayMode {
  AI // bepul, matn bilan
  TEACHER // pullik, qo'lyozma rasmlari bilan
}

/// Erkin esse (testdan tashqari): o'quvchi yozadi, AI yoki ustoz tekshiradi
model Essay {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        EssayMode     @default(AI)
  prompt      String // esse mavzusi
  text        String?
  imageUrls   String[] // MEDIA_DIR ichidagi nisbiy yo'llar: essays/<id>/<n>.jpg
  status      EssayStatus   @default(DRAFT)
  error       String?
  priceUzs    Int? // ustoz tekshiruvi narxi (yuborilgan paytdagi)
  /// Ustozning belgilari: varoq rasmlari ustidagi chizgilar va xato yorliqlari, matndagi xatolar (vektor JSON)
  annotations Json?
  payment     Payment?
  reviews     EssayReview[]
  voice       VoiceNote?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

enum ReviewSource {
  AI
  TEACHER
}

model EssayReview {
  id          String       @id @default(cuid())
  essayId     String
  essay       Essay        @relation(fields: [essayId], references: [id], onDelete: Cascade)
  source      ReviewSource
  reviewerId  String?
  reviewer    User?        @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  provider    String? // deepseek | claude
  criteria    Json // [{key,label,score,max,comment}]
  mistakes    Json         @default("[]") // AI: [{wrong,right,note}]
  /// AI: xatolarning varoqdagi joyi (chizgi + yorliq) yoki matndagi o'rni — ustoz belgilari bilan bir xil format
  annotations Json?
  /// AI: aniq tavsiyalar [{focus, text, example}] — eng zaif bandlar bo'yicha, o'quvchining o'z jumlasi namunasi bilan
  tips        Json?
  totalScore  Float
  /// Esse tekshirilmaydigan holat (OFF_TOPIC, TOO_SHORT, ...)
  special     String?
  feedback    String?
  createdAt   DateTime     @default(now())
}

// ===================== Davomat =====================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id         String           @id @default(cuid())
  groupId    String
  group      Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId  String
  student    StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  markedById String?
  markedBy   User?            @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  notifiedAt DateTime? // ota-onaga yuborilgan vaqt
  createdAt  DateTime         @default(now())

  @@unique([studentId, date])
  @@index([groupId, date])
}

// ===================== To'lov va obuna =====================

model Plan {
  id            String         @id @default(cuid())
  name          String
  priceUzs      Int
  durationDays  Int            @default(30)
  description   String?
  sortOrder     Int            @default(0)
  isActive      Boolean        @default(true)
  subscriptions Subscription[]
  payments      Payment[]
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan               @relation(fields: [planId], references: [id])
  startsAt      DateTime
  endsAt        DateTime
  status        SubscriptionStatus @default(ACTIVE)
  /// Yuborilgan eslatma bosqichi: 0 yo'q, 1 "3 kun qoldi", 2 "1 kun qoldi", 3 "tugadi"
  reminderStage Int                @default(0)
  payment       Payment?
  createdAt     DateTime           @default(now())

  @@index([userId, endsAt])
}

enum PaymentMethod {
  MANUAL
  CLICK
  PAYME
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String? // obuna to'lovi
  plan           Plan?         @relation(fields: [planId], references: [id], onDelete: Restrict)
  essayId        String?       @unique // yoki: bitta esseni ustoz tekshiruvi uchun to'lov
  essay          Essay?        @relation(fields: [essayId], references: [id], onDelete: SetNull)
  method         PaymentMethod
  amountUzs      Int
  status         PaymentStatus @default(PENDING)
  receiptUrl     String? // qo'lda to'lov cheki: MEDIA_DIR ichidagi nisbiy yo'l (receipts/<id>.jpg)
  payerNote      String? // o'quvchi izohi (kimning kartasidan, qachon)
  externalId     String? // Click/Payme tranzaksiya id
  reviewedById   String?
  reviewedBy     User?         @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote     String?
  subscriptionId String?       @unique
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([method, externalId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// Offline guruh o'quvchisining oylik to'lovi (naqd/karta, darsda olinadi). Bir oyga bitta yozuv.
/// Qarzdor bilan ishlash tarixi: qo'ng'iroq, xabar, va'da, sabab. Bot eslatmalari ham yoziladi (kind BOT)
model PaymentFollowUp {
  id          String         @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month       String // "2026-11"
  kind        FollowUpKind
  note        String?
  /// Va'da qilingan to'lov sanasi
  promisedAt  DateTime?      @db.Date
  createdById String?
  createdBy   User?          @relation("FollowUpAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([month, studentId])
}

enum FollowUpKind {
  CALL // ota-ona/o'quvchiga qo'ng'iroq qilindi
  MESSAGE // yozildi
  PROMISE // to'lashga va'da berdi (promisedAt)
  REASON // to'lamaslik sababi (qiyin ahvol, ketmoqchi va h.k.)
  BOT // bot orqali avtomatik eslatma
}

model OfflinePayment {
  id         String         @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId    String?
  group      Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  month      String // "2026-11"
  amountUzs  Int
  note       String?
  markedById String?
  markedBy   User?          @relation("OfflinePaymentMarker", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())

  @@unique([studentId, month])
  @@index([groupId, month])
}

enum VoiceStatus {
  PROCESSING
  READY
  FAILED
}

/// Ustozning ovozli izohi: erkin esse (essayId) yoki mock essesi (attemptId + questionId) uchun bittadan
model VoiceNote {
  id           String      @id @default(cuid())
  essayId      String?     @unique
  essay        Essay?      @relation(fields: [essayId], references: [id], onDelete: Cascade)
  attemptId    String?
  questionId   String?
  /// MEDIA_DIR ichidagi nisbiy yo'llar: asl yozuv, Telegram uchun OGG/Opus, ilova uchun M4A
  originalPath String
  oggPath      String?
  m4aPath      String?
  durationSec  Int?
  status       VoiceStatus @default(PROCESSING)
  error        String?
  createdById  String?
  createdBy    User?       @relation("VoiceAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  sentAt       DateTime?
  createdAt    DateTime    @default(now())

  @@unique([attemptId, questionId])
}

/// Ilova sozlamalari (kalit -> JSON). Masalan: "billing" = karta rekvizitlari
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ===================== Audit =====================

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// ===================== Video =====================

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model Video {
  id            String      @id @default(cuid())
  status        VideoStatus @default(UPLOADING)
  originalName  String
  sizeBytes     BigInt
  receivedBytes BigInt      @default(0)
  durationSec   Int?
  variants      String[] // tayyor sifatlar: ["720p","480p"]
  processingPct Int? // ffmpeg jarayoni, 0..100
  error         String?
  createdById   String?
  createdBy     User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lesson        Lesson?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ===================== Admin kirishi =====================

/// Bot /admin buyrug'i orqali beriladigan bir martalik kirish havolasi (faqat xeshi saqlanadi)
model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Hali botga kirmagan odamni username bo'yicha yordamchi qilib qo'yish
model StaffInvite {
  username    String   @id // kichik harflarda, @ belgisisiz
  role        Role     @default(ASSISTANT)
  invitedById String?
  invitedBy   User?    @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}
