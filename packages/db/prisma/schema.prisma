generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== Foydalanuvchilar =====================

enum Role {
  STUDENT
  PARENT
  ASSISTANT
  TEACHER
}

enum StudyMode {
  ONLINE
  OFFLINE
}

model User {
  id           String   @id @default(cuid())
  telegramId   BigInt   @unique
  username     String?
  firstName    String
  lastName     String?
  phone        String?
  photoUrl     String?
  languageCode String?
  role         Role     @default(STUDENT)
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student       StudentProfile?
  parentLinks   ParentLink[]     @relation("ParentOf")
  parentLinksReviewed ParentLink[] @relation("ParentLinkReviewer")
  attempts      Attempt[]
  essays        Essay[]
  essayReviews  EssayReview[]    @relation("Reviewer")
  subscriptions Subscription[]
  payments      Payment[]
  paymentsReviewed Payment[]     @relation("PaymentReviewer")
  attendanceMarked Attendance[]  @relation("AttendanceMarker")
  offlinePaymentsMarked OfflinePayment[] @relation("OfflinePaymentMarker")
  lessonProgress LessonProgress[]
  auditLogs     AuditLog[]
  loginTokens   LoginToken[]
  videos        Video[]
  invitesSent   StaffInvite[]
}

model StudentProfile {
  id             String     @id @default(cuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode           StudyMode  @default(ONLINE)
  groupId        String?
  group          Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  parentLinkCode String     @unique // ota-ona botga shu kod bilan ulanadi
  parents        ParentLink[]
  attendance     Attendance[]
  offlinePayments OfflinePayment[]
  createdAt      DateTime   @default(now())
}

enum ParentLinkStatus {
  PENDING
  APPROVED
  REJECTED
}

/// O'quvchi va ota-ona bog'lanishi. Ota-ona bot orqali o'z raqamini ulashadi, ustoz/yordamchi tasdiqlaydi.
model ParentLink {
  id           String           @id @default(cuid())
  parentId     String
  parent       User             @relation("ParentOf", fields: [parentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status       ParentLinkStatus @default(PENDING)
  phone        String? // Telegram tasdiqlagan raqam (request_contact)
  relation     String? // ota, ona, boshqa
  flags        String[] // shubhali belgilar: same_phone, student_activity, many_children
  reviewedById String?
  reviewedBy   User?            @relation("ParentLinkReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  rejectReason String?
  createdAt    DateTime         @default(now())

  @@unique([parentId, studentId])
  @@index([status])
}

model Group {
  id        String           @id @default(cuid())
  name      String
  schedule  String? // masalan: "Du/Chor/Ju 14:00"
  /// Offline guruhning oylik to'lovi (so'm). To'lovni belgilashda standart summa
  monthlyFeeUzs Int?
  isActive  Boolean          @default(true)
  students  StudentProfile[]
  attendance Attendance[]
  offlinePayments OfflinePayment[]
  createdAt DateTime         @default(now())
}

// ===================== Kontent =====================

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  topics      Topic[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Topic {
  id        String     @id @default(cuid())
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int        @default(0)
  lessons   Lesson[]
  questions Question[]
  tests     Test[]
}

model Lesson {
  id          String   @id @default(cuid())
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title       String
  videoUrl    String? // tashqi havola (YouTube va h.k.)
  videoId     String?  @unique // serverga yuklangan himoyalangan video
  video       Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
  content     String? // konspekt (markdown)
  attachments Json     @default("[]") // [{name,url}]
  durationSec Int?
  order       Int      @default(0)
  isFree      Boolean  @default(false)
  isPublished Boolean  @default(false)
  progress    LessonProgress[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LessonProgress {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@id([userId, lessonId])
}

// ===================== Savollar va testlar =====================

enum QuestionType {
  SINGLE
  MULTIPLE
  MATCHING
  TEXT
  ESSAY // ustoz baholaydi
}

/// Bir nechta savol tayanadigan umumiy matn (o'qish matni, she'r, g'azal, drama parchasi)
model Passage {
  id        String     @id @default(cuid())
  title     String?
  body      String // markdown
  questions Question[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Question {
  id          String       @id @default(cuid())
  topicId     String?
  topic       Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  type        QuestionType @default(SINGLE)
  passageId   String?
  passage     Passage?     @relation(fields: [passageId], references: [id], onDelete: SetNull)
  text        String
  imageUrl    String?
  explanation String?
  difficulty  Int          @default(2) // 1..5
  correctText String? // TEXT turi uchun
  aiReview    Json? // AI tekshiruv natijasi
  options     Option[]
  tests       TestQuestion[]
  answers     AttemptAnswer[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  matchKey   String? // MATCHING uchun juftlik
  order      Int      @default(0)
}

enum TestType {
  TOPIC
  MOCK
}

enum GradingScale {
  NONE
  MILLIY_SERTIFIKAT // 100 ballik, A+ ... C darajalar
}

model Test {
  id           String         @id @default(cuid())
  type         TestType
  title        String
  description  String?
  topicId      String?
  topic        Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  timeLimitSec Int?
  shuffle      Boolean        @default(true)
  gradingScale GradingScale   @default(NONE)
  isFree       Boolean        @default(false)
  isPublished  Boolean        @default(false)
  questions    TestQuestion[]
  attempts     Attempt[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model TestQuestion {
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  points     Float    @default(1)

  @@id([testId, questionId])
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model Attempt {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId     String
  test       Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  status     AttemptStatus   @default(IN_PROGRESS)
  startedAt  DateTime        @default(now())
  deadlineAt DateTime? // server vaqti bo'yicha
  finishedAt DateTime?
  score      Float?
  maxScore   Float?
  answers    AttemptAnswer[]

  @@index([userId, testId])
}

model AttemptAnswer {
  attemptId   String
  attempt     Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionIds   String[]
  textAnswer  String?
  isCorrect   Boolean?
  points      Float? // ESSAY uchun ustoz baholaguncha null
  answeredAt  DateTime @default(now())
  reviewComment String?
  reviewedById  String?
  reviewedAt    DateTime?

  @@id([attemptId, questionId])
}

// ===================== Esse =====================

enum EssayStatus {
  SUBMITTED
  AI_CHECKING
  AI_CHECKED
  REVIEWED
}

model Essay {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    String // esse mavzusi
  text      String?
  imageUrls String[]
  status    EssayStatus   @default(SUBMITTED)
  reviews   EssayReview[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum ReviewSource {
  AI
  TEACHER
}

model EssayReview {
  id         String       @id @default(cuid())
  essayId    String
  essay      Essay        @relation(fields: [essayId], references: [id], onDelete: Cascade)
  source     ReviewSource
  reviewerId String?
  reviewer   User?        @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  provider   String? // deepseek | claude
  criteria   Json // [{key,score,max,comment}]
  totalScore Float
  feedback   String?
  createdAt  DateTime     @default(now())
}

// ===================== Davomat =====================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id         String           @id @default(cuid())
  groupId    String
  group      Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId  String
  student    StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  markedById String?
  markedBy   User?            @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  notifiedAt DateTime? // ota-onaga yuborilgan vaqt
  createdAt  DateTime         @default(now())

  @@unique([studentId, date])
  @@index([groupId, date])
}

// ===================== To'lov va obuna =====================

model Plan {
  id            String         @id @default(cuid())
  name          String
  priceUzs      Int
  durationDays  Int            @default(30)
  description   String?
  sortOrder     Int            @default(0)
  isActive      Boolean        @default(true)
  subscriptions Subscription[]
  payments      Payment[]
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  status    SubscriptionStatus @default(ACTIVE)
  /// Yuborilgan eslatma bosqichi: 0 yo'q, 1 "3 kun qoldi", 2 "1 kun qoldi", 3 "tugadi"
  reminderStage Int            @default(0)
  payment   Payment?
  createdAt DateTime           @default(now())

  @@index([userId, endsAt])
}

enum PaymentMethod {
  MANUAL
  CLICK
  PAYME
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan          @relation(fields: [planId], references: [id])
  method         PaymentMethod
  amountUzs      Int
  status         PaymentStatus @default(PENDING)
  receiptUrl     String? // qo'lda to'lov cheki: MEDIA_DIR ichidagi nisbiy yo'l (receipts/<id>.jpg)
  payerNote      String? // o'quvchi izohi (kimning kartasidan, qachon)
  externalId     String? // Click/Payme tranzaksiya id
  reviewedById   String?
  reviewedBy     User?         @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote     String?
  subscriptionId String?       @unique
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([method, externalId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// Offline guruh o'quvchisining oylik to'lovi (naqd/karta, darsda olinadi). Bir oyga bitta yozuv.
model OfflinePayment {
  id         String         @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId    String?
  group      Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  month      String // "2026-11"
  amountUzs  Int
  note       String?
  markedById String?
  markedBy   User?          @relation("OfflinePaymentMarker", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now())

  @@unique([studentId, month])
  @@index([groupId, month])
}

/// Ilova sozlamalari (kalit -> JSON). Masalan: "billing" = karta rekvizitlari
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ===================== Audit =====================

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// ===================== Video =====================

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model Video {
  id            String      @id @default(cuid())
  status        VideoStatus @default(UPLOADING)
  originalName  String
  sizeBytes     BigInt
  receivedBytes BigInt      @default(0)
  durationSec   Int?
  variants      String[] // tayyor sifatlar: ["720p","480p"]
  processingPct Int? // ffmpeg jarayoni, 0..100
  error         String?
  createdById   String?
  createdBy     User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lesson        Lesson?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ===================== Admin kirishi =====================

/// Bot /admin buyrug'i orqali beriladigan bir martalik kirish havolasi (faqat xeshi saqlanadi)
model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Hali botga kirmagan odamni username bo'yicha yordamchi qilib qo'yish
model StaffInvite {
  username    String   @id // kichik harflarda, @ belgisisiz
  role        Role     @default(ASSISTANT)
  invitedById String?
  invitedBy   User?    @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}
