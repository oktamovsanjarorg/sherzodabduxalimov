# Staging muhiti (noutbukda). Nusxa oling: cp .env.staging.example .env.staging
# DATABASE_URL, REDIS_URL va QUEUE_PREFIX'ni docker-compose.staging.yml o'zi beradi.

# --- Telegram: FAQAT test bot (BotFather'da alohida ochilgan). Prod tokenini bu yerga yozmang ---
BOT_TOKEN=
BOT_USERNAME=                     # test botning username'i, @ belgisisiz
MINIAPP_URL=https://staging.sherzodabduxalimov.uzbek-talim.uz

# --- API ---
API_PORT=4100
JWT_SECRET=                       # prod'dagidan boshqa bo'lsin: openssl rand -hex 32
JWT_TTL=1h
INIT_DATA_MAX_AGE_SEC=86400
CORS_ORIGINS=https://staging.sherzodabduxalimov.uzbek-talim.uz

# --- AI (kerak bo'lmasa none qoldiring) ---
AI_PROVIDER=none
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- Admin ---
OWNER_USERNAMES=sanjaroktamov,sherzod_abduxalimov
ADMIN_URL=https://staging.sherzodabduxalimov.uzbek-talim.uz/admin

# --- Tunnel (scripts/staging.sh) ---
STAGING_SSH_HOST=onatili-yangi    # ~/.ssh/config dagi prod server nomi
STAGING_REMOTE_BIND=172.18.0.1:18098  # serverda edge-caddy shu manzilga proxy qiladi
