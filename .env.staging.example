# Staging muhiti. Serverda /home/ubuntu/onatili-staging/.env.staging, noutbukda deploy uchun ham kerak. Nusxa oling: cp .env.staging.example .env.staging
# DATABASE_URL, REDIS_URL va QUEUE_PREFIX'ni docker-compose.staging.yml o'zi beradi.

# --- Telegram: FAQAT test bot (BotFather'da alohida ochilgan). Prod tokenini bu yerga yozmang ---
BOT_TOKEN=
BOT_USERNAME=                     # test botning username'i, @ belgisisiz
MINIAPP_URL=https://staging.sherzodabduxalimov.uzbek-talim.uz

# --- API ---
API_PORT=4100
JWT_SECRET=                       # prod'dagidan boshqa bo'lsin: openssl rand -hex 32
JWT_TTL=1h
INIT_DATA_MAX_AGE_SEC=86400
CORS_ORIGINS=https://staging.sherzodabduxalimov.uzbek-talim.uz

# --- AI (kerak bo'lmasa none qoldiring) ---
AI_PROVIDER=none
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- Admin ---
OWNER_USERNAMES=sanjaroktamov,sherzod_abduxalimov
ADMIN_URL=https://staging.sherzodabduxalimov.uzbek-talim.uz/admin

# --- Joylashuv (scripts/staging.sh) ---
STAGING_SSH_HOST=onatili-yangi    # ~/.ssh/config dagi server nomi (deploy shu yerga ulanadi)
STAGING_REMOTE_DIR=/home/ubuntu/onatili-staging
# Serverda: web shu manzilda ochiladi, edge-caddy unga proxy qiladi. Noutbukda: 127.0.0.1:8098
STAGING_WEB_BIND=172.18.0.1:18098
# 1 = noutbukda ishlatish (teskari SSH tunnel bilan). Serverda 0
STAGING_TUNNEL=0
STAGING_REMOTE_BIND=172.18.0.1:18098  # faqat tunnel uchun
