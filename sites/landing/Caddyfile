# ustoz-web ichki serveri. TLS va xavfsizlik sarlavhalari edge-caddy'da.
:80 {
	root * /srv
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	@assets path *.css *.js *.svg *.png *.jpg *.webp
	header @assets Cache-Control "no-cache"
	file_server
	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
